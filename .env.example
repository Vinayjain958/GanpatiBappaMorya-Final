# ==============================================================================
# LocaLens — Environment Variable Contract
# ==============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# The application should start in local development even when most values are
# absent — missing optional services will fall back to mock adapters.
# ==============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
# Options: development | staging | production

APP_SECRET_KEY=
# Required in production. Used for session signing.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./localens_dev.db
# Local development default: SQLite (async).
# Production: postgresql+asyncpg://user:password@host:5432/localens

# ─── Authentication (Phase 3) ──────────────────────────────────────────────────
# CORS: comma-separated list of frontend origins allowed to send credentialed
# requests. NEVER use "*" together with credentials.
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

JWT_ACCESS_SECRET=
# Required in staging/production — distinct from JWT_REFRESH_SECRET.
# Falls back to an insecure dev-only default locally; the app refuses to
# start in production with the default value.
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
JWT_ISSUER=localens
JWT_AUDIENCE=localens-app

# Refresh-token cookie. Left blank, the name is computed automatically:
# "__Host-localens_refresh" when Secure (staging/production), otherwise
# a plain "localens_refresh" (Secure cookies are rejected by browsers over
# plain HTTP, which local dev normally is).
REFRESH_COOKIE_NAME=
COOKIE_SECURE=
# true|false. Left blank: Secure in staging/production, not Secure in
# development (so the cookie still works over local HTTP).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Leave blank for a host-only cookie unless you specifically need to share
# the cookie across subdomains.

# Dev-only: creates/updates a single ADMIN account via
# `python scripts/create_admin.py`. ADMIN can never self-register via the
# API. Never hardcode these — always come from the environment.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ─── AI — Google Gemini (Phase 5) ──────────────────────────────────────────────
GEMINI_ENABLED=true
# Demo-room kill switch, independent of key presence. When false — or when
# GEMINI_API_KEY is unset — the AI adapter falls back to MockAIAdapter:
# text discovery stays usable (deterministic keyword extraction), but
# voice always reports unavailable rather than faking a connection.

GEMINI_API_KEY=
# Required for real AI features. NEVER expose in client/browser code —
# the API backend issues short-lived ephemeral tokens to the browser for
# Gemini Live sessions (POST /api/v1/auth/live-token); the master key
# remains server-side only, never logged, never persisted.

GEMINI_MODEL_TEXT=gemini-2.5-flash
# Text model used for structured TravelerContext extraction (one call
# per conversational turn). gemini-3.8-flash returned a persistent
# 503 RESOURCE_EXHAUSTED on this account's preview-tier capacity —
# gemini-2.5-flash is the verified-working default (see
# docs/CHANGELOG.md 2026-09-25).

GEMINI_MODEL_LIVE=gemini-3.8-live

# ─── Domain intelligence — Nugen (server-side only) ───────────────────────────
# Optional. When NUGEN_API_KEY is set, the Digital Twin explanation uses the
# Nugen domain-aligned model. Gemini conversation/voice behavior is unchanged.
# Never expose this credential through NEXT_PUBLIC_* or browser configuration.
NUGEN_API_KEY=
NUGEN_MODEL_ENDPOINT=https://api.nugen.in/api/v3/inference/chat/completions/model_01m3gmmw27xbf7m
NUGEN_MODEL_ID=model_01m3gmmw27xbf7m
NUGEN_REQUEST_TIMEOUT_SECONDS=15
# Model used for Gemini Live voice sessions.

GEMINI_LIVE_TOKEN_TTL_SECONDS=60
# How long an issued ephemeral token remains valid to START a new Live
# session (Google's own default: 1 minute). Kept short and explicit.

GEMINI_LIVE_SESSION_TTL_SECONDS=1800
# Once connected, how long the Live session stays usable (Google's own
# default: 30 minutes) before a fresh token/reconnect is required.

GEMINI_MIN_INTERVAL_SECONDS=0.5
# Self-imposed pacing between text-generation calls to Gemini (mirrors
# the Phase 4 location adapters' IntervalRateLimiter pattern).

CONVERSATION_HISTORY_WINDOW=12
# Bounded recent-turn window sent to the model on every text turn —
# conversation history is never sent unbounded.

# ─── Semantic Embeddings (Phase 6) ─────────────────────────────────────────────
# Real GeminiEmbeddingAdapter is selected by the same rule as the text/Live
# adapter above (GEMINI_ENABLED=true AND GEMINI_API_KEY set); otherwise
# MockEmbeddingAdapter (deterministic, not random) is used — the app always
# starts and embeddings never silently fail closed.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536
# Output vector dimensionality. LIVE VERIFIED against SQLite semantic
# retrieval (see docs/DECISIONS.md ADR-055 / docs/PROJECT_STATE.md
# Phase 6). PostgreSQL/pgvector path remains NOT VERIFIED — no
# PostgreSQL instance available in this environment.

# ─── Semantic Retrieval (Phase 6) ──────────────────────────────────────────────
SEMANTIC_SEARCH_ENABLED=true
# When false, or when embedding generation fails/is unavailable, retrieval
# falls back to the existing Phase 4 keyword search (retrieval_mode:
# "keyword_fallback" in the API response — always honestly reported).

SEMANTIC_RESULT_LIMIT=5
# Max FEASIBLE items returned by POST /api/v1/experiences/semantic-search.

SEMANTIC_CANDIDATE_POOL_SIZE=50
# Default candidate pool size pulled from retrieval before the
# deterministic feasibility gate is applied.

SEMANTIC_MAX_CANDIDATE_POOL_SIZE=200
# Hard ceiling on the candidate pool size, regardless of caller request.

# ─── Maps & Location (Phase 4) ─────────────────────────────────────────────────
# No API key required for Nominatim/OSRM/Overpass — all public OSM-ecosystem
# services accessed through backend adapters (never directly from the
# browser). Set LOCATION_SERVICES_ENABLED=false to force the Mock*Adapter
# fallback (e.g. offline dev, CI, a network-restricted demo room) — the
# experience catalog keeps working without any of these.
LOCATION_SERVICES_ENABLED=true

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Required by Nominatim's usage policy: a descriptive User-Agent identifying
# this application (not a browser UA) — include real contact info in production.
NOMINATIM_USER_AGENT=LocaLens/0.1 (hackathon-prototype; contact=dev@localens.example)
NOMINATIM_MIN_INTERVAL_SECONDS=1.0
NOMINATIM_CACHE_TTL_SECONDS=3600

OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_MIN_INTERVAL_SECONDS=2.0
OVERPASS_CACHE_TTL_SECONDS=900
OVERPASS_MAX_RADIUS_M=2000

OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
# driving | walking | cycling — must be one of OSRM_ALLOWED_PROFILES.
OSRM_MIN_INTERVAL_SECONDS=1.0
OSRM_CACHE_TTL_SECONDS=900
OSRM_MAX_MATRIX_DESTINATIONS=25

DISCOVERY_MAX_RADIUS_KM=25.0
DISCOVERY_CANDIDATE_CAP=1000

# MapTiler / MapLibre tile server (optional; OpenFreeMap used as the
# no-key default — see NEXT_PUBLIC_MAP_STYLE_URL below)
MAPTILER_API_KEY=

MAPBOX_API_KEY=
# Second-tier live Safety resources provider (src/services/safety/
# resource_adapters.py MapboxSafetyResourceAdapter) — tried only when the
# free Overpass/mirror chain fails, in auto mode. Optional; when absent,
# auto mode falls straight from Overpass to seed data, same as before
# this tier existed.

# ─── Weather ──────────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=
# Used by the WeatherAdapter. Falls back to mock data when absent.

# ─── Events ───────────────────────────────────────────────────────────────────
TICKETMASTER_API_KEY=
# Used by the EventAdapter. Falls back to seed/mock events when absent.

# ─── Public social context (Task 3) ───────────────────────────────────────────
SOCIAL_SIGNALS_ENABLED=true
# Read-only Bluesky public search. No Bluesky credential is sent to the browser.
# Set false to disable the opt-in Social Pulse context layer.

# ─── Safety resources (Phase 11) ───────────────────────────────────────────────
SAFETY_RESOURCES_MODE=auto
# auto: try the live OSM/Overpass adapter first, fall back to deterministic
# seed data only on a genuine provider failure (network error/timeout/bad
# response) — never merely because live returned zero results.
# live: never falls back, surfaces a service error instead.
# fallback: always uses seed data (explicit test/demo mode).
# On a provider failure, the primary Overpass URL and each configured
# mirror (SAFETY_RESOURCES_MIRROR_URLS, defaults built in) are tried in
# order before giving up — the public instances load-shed independently.

# ─── Wikimedia Commons image resolution ────────────────────────────────────────
WIKIMEDIA_USER_AGENT=
# No API key required — Wikimedia's public MediaWiki API is unauthenticated,
# but every request must send a meaningful identifying User-Agent per
# https://meta.wikimedia.org/wiki/User-Agent_policy. Falls back to a
# documented, non-personal default (see src/core/config.py) when unset, so
# the app still boots without a .env file; set this to identify your own
# deployment (e.g. "LocaLens/1.0 (https://your-domain.example; you@example.com)").

# ─── Deployment — Supabase / PostgreSQL ───────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only required in staging/production. Not used in local SQLite mode.

# ─── Frontend (Next.js public variables — MUST be NEXT_PUBLIC_ prefixed) ──────
# These are embedded at build time and visible to the browser.
# NEVER place secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Backend FastAPI base URL accessible from the browser.

NEXT_PUBLIC_APP_NAME=LocaLens
NEXT_PUBLIC_APP_VERSION=0.1.0
